# Headless delivery — set these and this deployment renders the PUBLISHED
# SnabbSajt site instead of the local `src/site.ts`.
#
# Server-only. Never prefix them with NEXT_PUBLIC_ and never commit real
# values: the token is read-only and scoped to one site, but it is still a
# credential.
#
# Both values are shown in SnabbSajt under
# Settings → Developers → "Var hemsidan visas" / "Nycklar för er app".
# A key is shown once — we store only its hash.

SNABBSAJT_SITE_ID=
SNABBSAJT_DELIVERY_TOKEN=

# Optional. Defaults to the production delivery host; set it only for a
# staging deployment. Must be https.
# SNABBSAJT_API_URL=https://<deployment>.convex.site
